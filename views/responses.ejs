<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Ответы — <%= form.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  <div class="max-w-4xl mx-auto py-10 px-4">
    <a href="/admin" class="text-blue-600 mb-4 inline-block">← Назад</a>
    <h1 class="text-2xl font-bold mb-6">Ответы: <%= form.title %></h1>

    <% if (responses.length === 0) { %>
      <p class="text-gray-500">Ответов пока нет.</p>
    <% } else { %>
      <div class="space-y-4">
        <% responses.forEach((r, i) => { %>
          <div class="bg-white p-4 rounded-lg shadow">
            <p class="text-sm text-gray-500 mb-2">
              #<%= i + 1 %> — <%= r.created_at %>
            </p>
            <% form.fields.forEach(field => { %>
              <p><strong><%= field %>:</strong> <%= r.data[field] %></p>
            <% }) %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>